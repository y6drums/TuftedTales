---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import AnnouncementBar from "../components/AnnouncementBar.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Tufted Tales Studio — Where Tuft Happens",
  description = "A hands-on rug tufting studio in Columbus, Georgia. Book a workshop, host a private party, or commission a custom rug. Opening September 2026.",
  ogImage = "/brand/tts-wordmark.svg",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#064946" />

    <!-- LocalBusiness JSON-LD (site-wide) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "@id": "https://tuftedtalesstudio.com/#business",
      "name": "Tufted Tales Studio",
      "description": "Rug tufting and Tale Bears studio in Columbus, GA offering hands-on beginner-friendly workshops, private parties, and custom hand-tufted rugs.",
      "url": "https://tuftedtalesstudio.com/",
      "telephone": "+1-706-577-1219",
      "email": "hello@tuftedtalesstudio.com",
      "image": "https://tuftedtalesstudio.com/brand/tts-wordmark.svg",
      "logo": "https://tuftedtalesstudio.com/brand/tts-wordmark.svg",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "7613 Fortson Rd, Suite B",
        "addressLocality": "Columbus",
        "addressRegion": "GA",
        "postalCode": "31808",
        "addressCountry": "US"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 32.5852,
        "longitude": -84.9975
      },
      "areaServed": [
        { "@type": "City", "name": "Columbus, GA" },
        { "@type": "AdministrativeArea", "name": "Chattahoochee Valley" },
        { "@type": "City", "name": "Phenix City, AL" },
        { "@type": "City", "name": "Auburn, AL" },
        { "@type": "City", "name": "LaGrange, GA" },
        { "@type": "City", "name": "Fortson, GA" },
        { "@type": "City", "name": "Midland, GA" }
      ],
      "sameAs": [
        "https://www.instagram.com/tuftedtalescolumbus",
        "https://www.tiktok.com/@tuftedtalescolumbus",
        "https://www.facebook.com/tuftedtalescolumbus",
        "https://www.youtube.com/@tuftedtalescolumbus"
      ]
    })} />
  </head>
  <body>
    <AnnouncementBar />
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // Progressive-enhancement form handler.
      // Hijacks any <form data-tts-form> and POSTs to its action, showing inline success/error.
      document.querySelectorAll<HTMLFormElement>("form[data-tts-form]").forEach((form) => {
        const submit = form.querySelector<HTMLButtonElement>("button[type='submit']");
        const originalSubmitText = submit?.textContent ?? "";

        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          if (!submit) return;

          const status = ensureStatusEl(form);
          status.className = "tts-form-status tts-form-status--pending";
          status.textContent = "Sending…";
          submit.disabled = true;
          submit.textContent = "Sending…";

          try {
            const res = await fetch(form.action || "/api/submit", {
              method: form.method || "POST",
              body: new FormData(form),
              headers: { Accept: "application/json" },
            });
            const data = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };

            if (res.ok && data.ok) {
              showSuccess(form);
              return;
            }
            throw new Error(data.error || "Something went wrong. Please try again.");
          } catch (err) {
            status.className = "tts-form-status tts-form-status--error";
            status.textContent = (err as Error).message || "Something went wrong. Please try again.";
            submit.disabled = false;
            submit.textContent = originalSubmitText;
          }
        });
      });

      function ensureStatusEl(form: HTMLFormElement): HTMLElement {
        let el = form.querySelector<HTMLElement>(".tts-form-status");
        if (!el) {
          el = document.createElement("p");
          el.className = "tts-form-status";
          form.appendChild(el);
        }
        return el;
      }

      function showSuccess(form: HTMLFormElement) {
        const successMessage = form.dataset.successMessage || "Thanks! We got your message and will be in touch soon.";
        const successTitle = form.dataset.successTitle || "You're in!";
        const paragraphs = successMessage
          .split(/\n\n+/)
          .map((p) => `<p class="tts-form-success__body">${escapeHtml(p.trim())}</p>`)
          .join("");
        form.innerHTML = `
          <div class="tts-form-success">
            <div class="tts-form-success__title">${escapeHtml(successTitle)}</div>
            ${paragraphs}
          </div>
        `;
      }

      function escapeHtml(v: string): string {
        return v.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c] as string));
      }
    </script>
  </body>
</html>
