---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";

const experiences = [
  {
    key: "signature",
    label: "Signature",
    title: "Signature Tuft Experience",
    price: "$85",
    priceUnit: "per person",
    tone: "teal",
    description:
      "Perfect for first-time tufters or anyone who wants to focus on creating their rug while our team professionally completes the finishing process. You'll enjoy the fun of tufting without having to worry about the technical finishing steps.",
    includes: [
      "3–3.5 hour instructor-led workshop",
      "Choose from our curated design library",
      "All materials, tools, and premium yarn included",
      "20+ yarn colors to choose from",
      "Professional shaving, trimming, gluing, and backing completed by our team",
      "Finished rug ready for pickup within 24–48 hours",
    ],
    bestFor:
      "Guests who want a fun, stress-free tufting experience with a professionally finished rug.",
    buttonText: "Book Signature Tuft Experience",
  },
  {
    key: "complete",
    label: "Full Experience",
    title: "Complete Rug Maker Experience",
    price: "$99",
    priceUnit: "per person",
    tone: "cream",
    description:
      "Want to learn the complete rug-making process? In this hands-on workshop, you'll not only tuft your rug but also learn how to professionally shave, trim, glue, and back it yourself. You'll leave with new skills — and your finished rug.",
    includes: [
      "4–4.5 hour instructor-led workshop",
      "Choose from our curated design library",
      "All materials, tools, and premium yarn included",
      "20+ yarn colors to choose from",
      "Learn professional shaving, trimming, gluing, and backing techniques",
      "Take your completed rug home the same day",
    ],
    bestFor:
      "Guests who want the full rug-making experience and the confidence to finish their own projects.",
    buttonText: "Book Complete Rug Maker Experience",
  },
  {
    key: "talebears",
    label: "Paint Pour",
    title: "Tale Bears Experience",
    price: "From $34.99",
    priceUnit: "",
    tone: "terracotta",
    description:
      "Create a one-of-a-kind Tale Bear using our signature paint-pour technique. Choose your bear, select up to three paint colors, and design a keepsake that's uniquely yours.",
    includes: [
      "Standing 7-inch bear — $34.99, or standing 9-inch bear — $54.99",
      "Choose up to 3 paint colors",
      "7\" bear: one complimentary paint refill · 9\" bear: unlimited refills during your session",
      "Professionally sealed and ready for pickup in 24–48 hours",
    ],
    bestFor:
      "Families, kids (with adult supervision), date nights, girls' nights, birthday celebrations, college students, creative gifts.",
    buttonText: "Book Tale Bears Experience",
  },
];

const designCategories = [
  "Trending Designs",
  "Animals",
  "Sports",
  "Cartoons",
  "Anime",
  "Gaming",
  "Flowers & Nature",
  "Smiley Faces",
  "Inspirational Quotes",
  "Music",
  "Food & Drinks",
  "Holiday & Seasonal",
  "Abstract & Modern",
  "Sororities & Fraternities",
  "Beginner Favorites",
  "Coming Soon",
];

const rugSteps = [
  {
    n: "01",
    title: "Welcome & Safety Orientation",
    time: "30 minutes",
    body: "Meet your instructor, review safety guidelines, learn how to safely use the tufting gun, and prepare your design for tracing.",
  },
  {
    n: "02",
    title: "Choose Your Colors",
    time: "10 minutes",
    body: "Browse our premium yarn wall and select from 20+ premium yarn colors to bring your design to life.",
  },
  {
    n: "03",
    title: "Tuft Your Rug",
    time: "Approximately 2.5–3.5 hours",
    body: "Create your custom rug with step-by-step instruction from our team. No experience is necessary.",
  },
];

const bearSteps = [
  {
    n: "01",
    title: "Choose Your Bear",
    time: "5 minutes",
    body: "Select your favorite Tale Bear size — 7-inch or 9-inch.",
  },
  {
    n: "02",
    title: "Pick Your Colors",
    time: "10 minutes",
    body: "Choose up to 3 paint colors to create your unique design. The 7-inch bear includes one complimentary paint refill; the 9-inch bear includes unlimited paint refills during your session.",
  },
  {
    n: "03",
    title: "Pour & Create",
    time: "20–30 minutes",
    body: "Use our signature paint-pour technique to transform your Tale Bear into a one-of-a-kind creation. No two Tale Bears are ever alike.",
  },
  {
    n: "04",
    title: "Drying & Finishing",
    time: "Pickup within 24–48 hours",
    body: "Your Tale Bear is professionally sealed and prepared for pickup.",
  },
];
---

<Layout title="Workshops · Tufted Tales Studio" description="Choose your creative experience — rug tufting workshops from $85 and Tale Bears from $34.99. Beginner-friendly. Columbus, GA.">
  <PageHero
    eyebrow="Workshops"
    script="Create & Connect"
    title="Leave with a story."
    subtitle="Choose the creative experience that's right for you. Whether you're crafting a custom rug or designing a one-of-a-kind Tale Bear, every visit is hands-on, beginner-friendly, and designed to leave you with something uniquely yours."
  />

  <!-- EXPERIENCE CARDS -->
  <section>
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Choose Your Experience</span>
        <h2>Three ways to create.</h2>
        <p class="lede">
          Every experience includes expert instruction, premium materials, and plenty of opportunities to create lasting memories.
        </p>
      </div>

      <div class="exp-grid">
        {experiences.map((e) => (
          <article class={`exp-card ${e.tone}`}>
            <span class="chip">{e.label}</span>
            <h3>{e.title}</h3>
            <p class="price">{e.price}{e.priceUnit && <span> {e.priceUnit}</span>}</p>
            <p class="desc">{e.description}</p>
            <div class="incl-block">
              <span class="incl-label">Includes</span>
              <ul class="feat">
                {e.includes.map((i) => <li>{i}</li>)}
              </ul>
            </div>
            <div class="best-block">
              <span class="incl-label">Best For</span>
              <p class="best">{e.bestFor}</p>
            </div>
            <a href="#book" class="btn btn-primary exp-cta">{e.buttonText}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- DESIGN LIBRARY -->
  <section class="design-lib">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Choose Your Design</span>
        <h2>Find the design that tells your story.</h2>
        <p class="lede">
          Browse our growing collection of beginner-friendly designs, carefully selected to create beautiful rugs. Whether you're looking for something fun, trendy, bold, or meaningful, there's a design waiting for you.
        </p>
      </div>

      <ul class="cat-grid" aria-label="Design categories">
        {designCategories.map((c) => (
          <li class="cat-tile">{c}</li>
        ))}
      </ul>

      <p class="lib-note">
        Our design library is growing weekly. New designs are added regularly across every category.
      </p>

      <div class="lib-cta">
        <a href="#book" class="btn btn-primary">Browse Design Library</a>
      </div>
    </div>
  </section>

  <!-- ACUITY BOOKING EMBED -->
  <section id="book" class="booking">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Book Your Seat</span>
        <h2>Pick a date that works for you.</h2>
        <p class="lede">
          Live availability from our booking calendar. Booking opens with our September 2026 launch —
          in the meantime, <a href="/waitlist">join the waitlist</a> for early access.
        </p>
      </div>

      <iframe
        src="https://app.acuityscheduling.com/schedule.php?owner=40006397&ref=embedded_csp"
        title="Schedule Appointment"
        width="100%"
        height="800"
        frameborder="0"
        allow="payment"
        class="acuity-embed"
        loading="lazy"
      ></iframe>
      <script src="https://embed.acuityscheduling.com/js/embed.js" type="text/javascript" is:inline></script>
    </div>
  </section>

  <!-- WHAT TO EXPECT — RUG TUFTING -->
  <section class="expect">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What to Expect</span>
        <h2>Your Tufting Experience.</h2>
        <p class="lede">
          Choose the experience that's right for you. Both workshops follow the same creative process — the difference is how your rug is finished.
        </p>
      </div>

      <ol class="timeline">
        {rugSteps.map((s) => (
          <li>
            <div class="step">{s.n}</div>
            <div>
              <h3>{s.title} <span class="step-time">({s.time})</span></h3>
              <p>{s.body}</p>
            </div>
          </li>
        ))}
        <li>
          <div class="step">04</div>
          <div>
            <h3>Finish Your Rug</h3>
            <div class="finish-split">
              <div class="finish-card">
                <span class="incl-label">Signature Tuft Experience · $85</span>
                <p>Our team professionally shaves, trims, glues, and backs your rug. Your finished rug will be ready for pickup within 24–48 hours.</p>
              </div>
              <div class="finish-card">
                <span class="incl-label">Complete Rug Maker Experience · $99 · +45 min</span>
                <p>Continue for approximately one additional hour to learn how to professionally shave, trim, glue, and back your rug yourself. Take your finished rug home the same day.</p>
              </div>
            </div>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- WHAT TO EXPECT — TALE BEARS -->
  <section class="expect bears">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What to Expect — Tale Bears</span>
        <h2>Your Tale Bears Experience.</h2>
      </div>

      <ol class="timeline">
        {bearSteps.map((s) => (
          <li>
            <div class="step">{s.n}</div>
            <div>
              <h3>{s.title} <span class="step-time">({s.time})</span></h3>
              <p>{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Layout>

<style>
  .section-head { max-width: 720px; margin-bottom: 40px; }
  .section-head.center { margin-left: auto; margin-right: auto; text-align: center; }
  .section-head h2 { font-size: clamp(1.8rem, 3.5vw, 2.6rem); line-height: 1.1; margin-bottom: 12px; }
  .lede { font-size: 1.05rem; color: var(--ink-soft); margin: 0; }

  /* EXPERIENCE CARDS */
  .exp-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 2.5vw, 28px);
    align-items: stretch;
  }
  @media (max-width: 960px) { .exp-grid { grid-template-columns: 1fr; max-width: 640px; margin: 0 auto; } }

  .exp-card {
    border-radius: var(--radius-lg);
    padding: clamp(24px, 2.8vw, 36px);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .exp-card.teal { background: var(--teal); color: var(--cream); }
  .exp-card.teal h3, .exp-card.teal .price { color: var(--cream); }
  .exp-card.teal .chip { background: rgba(238, 214, 191, 0.15); color: var(--cream); }
  .exp-card.teal .price { color: var(--sage); }
  .exp-card.teal .feat li::before { color: var(--sage); }
  .exp-card.teal .incl-label { color: var(--sage); }

  .exp-card.cream { background: var(--cream); color: var(--teal-ink); }
  .exp-card.cream .chip { background: var(--terracotta); color: var(--cream); }

  .exp-card.terracotta { background: var(--terracotta); color: var(--cream); }
  .exp-card.terracotta h3, .exp-card.terracotta .price { color: var(--cream); }
  .exp-card.terracotta .chip { background: rgba(238, 214, 191, 0.18); color: var(--cream); }
  .exp-card.terracotta .feat li::before { color: var(--cream); }
  .exp-card.terracotta .incl-label { color: var(--cream); opacity: 0.85; }

  .exp-card h3 { font-size: 1.5rem; margin: 6px 0 0; line-height: 1.15; }
  .desc { margin: 0; font-size: 0.95rem; opacity: 0.92; }
  .price {
    font-family: var(--font-block);
    font-size: 1.7rem;
    color: var(--terracotta);
    margin: 0;
    letter-spacing: 0.02em;
  }
  .price span {
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    opacity: 0.75;
    margin-left: 8px;
    font-family: var(--font-body);
    font-weight: 500;
    color: currentColor;
  }
  .incl-block, .best-block { display: flex; flex-direction: column; gap: 6px; }
  .incl-label {
    font-family: var(--font-block);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: var(--terracotta);
    text-transform: uppercase;
  }
  .feat { list-style: none; padding: 0; margin: 4px 0 0; display: flex; flex-direction: column; gap: 8px; font-size: 0.92rem; line-height: 1.4; }
  .feat li { padding-left: 20px; position: relative; }
  .feat li::before { content: "→"; position: absolute; left: 0; top: 0; color: var(--terracotta); font-weight: 700; }
  .best { margin: 0; font-size: 0.92rem; opacity: 0.92; line-height: 1.4; }
  .exp-cta { margin-top: auto; align-self: flex-start; }
  .exp-card.cream .exp-cta { background: var(--teal); color: var(--cream); border-color: var(--teal); }
  .exp-card.cream .exp-cta:hover { background: var(--teal-ink); }
  .exp-card.terracotta .exp-cta { background: var(--cream); color: var(--terracotta-deep); border-color: var(--cream); }
  .exp-card.terracotta .exp-cta:hover { background: #fff; color: var(--terracotta-deep); }

  /* DESIGN LIBRARY */
  .design-lib { background: var(--cream); }
  .cat-grid {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }
  @media (max-width: 900px) { .cat-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 600px) { .cat-grid { grid-template-columns: repeat(2, 1fr); } }
  .cat-tile {
    background: #fff;
    color: var(--teal-ink);
    padding: 22px 18px;
    border-radius: var(--radius);
    font-family: var(--font-block);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.78rem;
    text-align: center;
    border: 1px solid var(--line);
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  }
  .cat-tile:hover { transform: translateY(-2px); box-shadow: var(--shadow-sm); background: var(--paper); }
  .lib-note { text-align: center; color: var(--ink-soft); margin: 0 0 24px; font-size: 0.95rem; font-style: italic; }
  .lib-cta { text-align: center; }

  /* BOOKING */
  .booking { background: var(--paper); }
  .acuity-embed {
    display: block;
    width: 100%;
    border: 0;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    background: #fff;
    min-height: 800px;
  }

  /* EXPECT */
  .expect.bears { background: var(--cream); }
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 24px;
    max-width: 820px;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 24px;
    align-items: flex-start;
  }
  .step {
    background: var(--terracotta);
    color: var(--cream);
    border-radius: 50%;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-block);
    font-size: 0.9rem;
    letter-spacing: 0.1em;
  }
  .timeline h3 { margin: 8px 0 6px; font-size: 1.2rem; }
  .step-time {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.85rem;
    color: var(--muted);
    letter-spacing: 0;
    margin-left: 6px;
  }
  .timeline p { margin: 0; color: var(--ink-soft); font-size: 0.98rem; }

  .finish-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 4px;
  }
  @media (max-width: 720px) { .finish-split { grid-template-columns: 1fr; } }
  .finish-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 16px 18px;
  }
  .finish-card .incl-label { display: block; margin-bottom: 6px; }
  .finish-card p { margin: 0; font-size: 0.92rem; color: var(--ink-soft); }
</style>
