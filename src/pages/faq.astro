---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";

const groups = [
  {
    title: "Before You Book",
    items: [
      {
        q: "How much is a workshop?",
        a: "Signature workshops are $75 per person. Custom workshops are $85 per person. Both are 2.5 hours and include all materials.",
      },
      {
        q: "What's included?",
        a: "Everything — instruction, the tufting gun, premium yarn (20+ colors to choose from), backing, glue, and professional finishing. You just show up.",
      },
      {
        q: "Do I need any experience?",
        a: "Nope. All workshops are beginner-friendly and led by an instructor from start to finish.",
      },
      {
        q: "What's the minimum age?",
        a: "14 years old for all workshops and private events. If you're under 18, a parent or guardian must sign off on the reservation.",
      },
      {
        q: "Can I pick my own yarn colors?",
        a: "Yes! We stock over 20 premium yarn colors and you'll pick your palette at the start of your workshop.",
      },
      {
        q: "How big will my rug be?",
        a: "Finished workshop rugs are typically between 24\" and 27\". Custom rugs can be any size — priced by dimensions and complexity.",
      },
    ],
  },
  {
    title: "The Day Of",
    items: [
      {
        q: "What should I wear?",
        a: "Closed-toed shoes are required, and bring a hair tie if you have long hair. Otherwise — come as you are.",
      },
      {
        q: "Can I bring a plus-one to watch?",
        a: "Only ticketed guests are allowed in the studio during workshops. If someone wants to join, they'll need their own ticket. A 'helper' add-on is a plus-one seat that doesn't create their own rug.",
      },
      {
        q: "What time should I arrive?",
        a: "Please arrive 5–10 minutes early. Instruction starts promptly to maximize tufting time.",
      },
      {
        q: "What if I'm late?",
        a: "Anyone more than 30 minutes late will not have time to finish and will forfeit their reservation. No refunds.",
      },
      {
        q: "Where do I park?",
        a: "Free parking is available at the studio (7613 Fortson Rd, Suite B).",
      },
      {
        q: "Are drinks or snacks available?",
        a: "Coming soon — we'll share details closer to opening. You're welcome to bring your own non-alcoholic drinks in the meantime.",
      },
    ],
  },
  {
    title: "After the Workshop",
    items: [
      {
        q: "When can I pick up my rug?",
        a: "Your rug will be professionally trimmed, glued, and backed by our team. Pickup is available in 24–48 hours after your workshop.",
      },
      {
        q: "Can you ship my rug?",
        a: "Yes — shipping is available for a fee based on size and destination. Just let us know at the end of your workshop.",
      },
    ],
  },
  {
    title: "Cancellations &amp; Rescheduling",
    items: [
      {
        q: "What's your cancellation policy?",
        a: "All workshop bookings are non-refundable.",
      },
      {
        q: "Can I reschedule?",
        a: "Reschedules are allowed with at least 72 hours' notice. Email hello@tuftedtalesstudio.com and we'll help move you to a different date.",
      },
      {
        q: "Custom rug deposits?",
        a: "Custom rugs require a 60% deposit to secure your spot in the queue. Deposits are non-refundable once your rug is in progress.",
      },
    ],
  },
  {
    title: "Private Events",
    items: [
      {
        q: "How do I book a private event?",
        a: "Fill out the inquiry form on our Private Events page. We'll follow up within 1 business day with availability and a custom quote.",
      },
      {
        q: "How much does it cost?",
        a: "Private events start at $600 for the studio + $65 per guest. Group discounts available for parties of 10+.",
      },
      {
        q: "Can you travel to my venue?",
        a: "Off-site events are possible for larger groups. Ask about travel details when you inquire.",
      },
    ],
  },
];
---

<Layout title="FAQ & Policies · Tufted Tales Studio" description="Answers to the most common questions about workshops, private events, and custom rugs at Tufted Tales Studio.">
  <PageHero
    eyebrow="FAQ &amp; Policies"
    script="Good question."
    title="Everything you might want to know."
    subtitleHtml='Still have questions? Email us at <a href="mailto:hello@tuftedtalesstudio.com">hello@tuftedtalesstudio.com</a>.'
  />

  <section>
    <div class="container faq-shell">
      {groups.map((g) => (
        <div class="faq-group">
          <h2 set:html={g.title} />
          <div class="qa-list">
            {g.items.map((it) => (
              <details class="qa">
                <summary>
                  <span set:html={it.q} />
                  <span class="chev" aria-hidden="true">+</span>
                </summary>
                <div class="qa-body"><p set:html={it.a} /></div>
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="policies">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Studio Policies</span>
        <h2>The short version.</h2>
      </div>
      <ol class="policy-list">
        <li>Minimum age is 14 for all workshops and private events.</li>
        <li>Arrive 5 minutes early. Instruction starts promptly.</li>
        <li>Anyone more than 30 minutes late forfeits their reservation. No refunds.</li>
        <li>Only ticketed guests are permitted inside the studio during workshops.</li>
        <li>All workshop bookings are non-refundable. Reschedules require 72 hours' notice.</li>
        <li>Custom rugs require a 60% deposit; non-refundable once work has started.</li>
      </ol>
    </div>
  </section>
</Layout>

<style>
  .faq-shell { max-width: 820px; margin: 0 auto; }
  .faq-group { margin-bottom: 48px; }
  .faq-group h2 {
    font-size: 1.4rem;
    color: var(--terracotta);
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--line);
    font-family: var(--font-block);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .qa-list { display: flex; flex-direction: column; gap: 8px; }
  .qa {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.2s;
  }
  .qa[open] { border-color: var(--teal); }
  .qa summary {
    padding: 20px 24px;
    cursor: pointer;
    font-weight: 700;
    color: var(--teal-ink);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    list-style: none;
  }
  .qa summary::-webkit-details-marker { display: none; }
  .chev {
    color: var(--terracotta);
    font-size: 1.4rem;
    font-weight: 700;
    transition: transform 0.2s;
  }
  .qa[open] .chev { transform: rotate(45deg); }
  .qa-body {
    padding: 0 24px 20px;
    color: var(--ink-soft);
  }
  .qa-body p { margin: 0; }

  .policies { background: var(--cream); }
  .section-head { max-width: 660px; margin-bottom: 32px; }
  .section-head h2 { font-size: clamp(1.8rem, 3.5vw, 2.6rem); line-height: 1.1; }
  .policy-list {
    counter-reset: p;
    list-style: none;
    padding: 0;
    max-width: 780px;
    margin: 0;
  }
  .policy-list li {
    counter-increment: p;
    padding: 16px 0 16px 60px;
    border-bottom: 1px solid var(--line);
    position: relative;
    color: var(--ink-soft);
  }
  .policy-list li::before {
    content: counter(p, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 16px;
    font-family: var(--font-block);
    color: var(--terracotta);
    letter-spacing: 0.14em;
    font-size: 0.9rem;
  }
</style>
