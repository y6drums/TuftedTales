---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";

const offers = [
  {
    title: "Rug Tufting Workshops",
    body: "Create your own custom rug using our beginner-friendly process and curated design library. Whether you choose our Signature Tuft Experience or Complete Rug Maker Experience, our instructors will guide you every step of the way.",
    href: "/workshops",
    cta: "See Workshops",
  },
  {
    title: "Tale Bears Experience",
    body: "Create a one-of-a-kind Tale Bear using our signature paint-pour technique. Choose your bear, select your colors, and design a keepsake that's uniquely yours.",
    href: "/workshops#book",
    cta: "Book Tale Bears",
  },
  {
    title: "Private Parties & Events",
    body: "Celebrate birthdays, girls' nights, date nights, team-building events, church outings, family gatherings, and more with a private creative experience designed just for your group.",
    href: "/private-events",
    cta: "Host an Event",
  },
  {
    title: "Studio Rentals",
    body: "Looking for a modern, creative venue? Rent the front studio, back studio, or the entire space for your next private event.",
    href: "/private-events#inquire",
    cta: "Rent the Studio",
  },
];
---

<Layout
  title="About Tufted Tales Studio — Rug Tufting in Columbus, GA"
  description="Meet the team behind Tufted Tales Studio, a rug tufting and Tale Bears studio in Columbus, GA serving the Chattahoochee Valley."
>
  <PageHero
    eyebrow="About"
    title="About Tufted Tales Studio"
    subtitle="Tufted Tales Studio is a rug tufting and Tale Bears studio in Columbus, Georgia, serving the Chattahoochee Valley. We teach people to make something by hand — a tufted rug or a paint-poured vinyl bear — in a relaxed, guided session."
  />

  <!-- OUR STORY -->
  <section>
    <div class="container story-shell">
      <div class="about-copy">
        <span class="eyebrow">Our Story</span>
        <h2>Built for creating — and connecting.</h2>
        <p>
          Tufted Tales Studio was created to bring a unique, hands-on creative experience to Columbus, Georgia. We wanted to build a place where anyone — regardless of artistic experience — could step into a welcoming environment, learn something new, and leave with something they created themselves.
        </p>
        <p>
          Our studio is built around more than creativity. It's built around connection. Friends laugh together, families create together, couples make memories together, and every guest leaves with a story worth telling.
        </p>
        <p>
          At Tufted Tales Studio, we believe every handmade creation tells a story — and we're excited to help you create yours.
        </p>
      </div>
    </div>
  </section>

  <!-- MISSION BAND -->
  <section class="mission-band">
    <div class="container center">
      <span class="eyebrow">Our Mission</span>
      <h2>Every guest leaves with more than a project.</h2>
      <p>
        Our mission is to inspire creativity, encourage connection, and provide unforgettable experiences where every guest can create something meaningful with their own hands. We believe the best memories are made together, and every visit to Tufted Tales Studio should end with a handmade creation and a story worth sharing.
      </p>
    </div>
  </section>

  <!-- WHAT WE OFFER -->
  <section>
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What We Offer</span>
        <h2>Four creative experiences under one roof.</h2>
      </div>
      <div class="offer-grid">
        {offers.map((o) => (
          <article class="offer-card">
            <h3>{o.title}</h3>
            <p>{o.body}</p>
            <a href={o.href} class="offer-link">{o.cta} →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FOUNDER -->
  <section class="founder">
    <div class="container founder-grid">
      <div class="visual">
        <img src="/photos/founder-portrait.jpg" alt="Taiylor Williams, founder of Tufted Tales Studio" class="about-photo square" />
      </div>
      <div class="founder-copy">
        <span class="eyebrow">Meet the Founder</span>
        <h2>Taiylor Williams.</h2>
        <p>
          When Taiylor Williams imagined Tufted Tales Studio, she wasn't trying to build just another art studio.
        </p>
        <ul class="studio-list">
          <li><span>A dance studio</span> teaches dance.</li>
          <li><span>A pottery studio</span> teaches pottery.</li>
          <li><span>A paint studio</span> teaches painting.</li>
          <li><span>A rug studio</span> teaches rug tufting.</li>
        </ul>
        <p class="founder-lede">
          <strong>Tufted Tales Studio was designed differently.</strong>
          It's a creative experience studio where every project tells a story.
        </p>
        <p>
          Whether you're creating your first custom rug, designing a Tale Bear, or celebrating a special occasion with family and friends, every experience is built around creativity, connection, and making memories that last long after you leave the studio.
        </p>
        <p>
          Because at Tufted Tales Studio, you don't just make something with your hands — you create a story that's uniquely yours.
        </p>
      </div>
    </div>
  </section>

  <!-- TAGLINE CTA BAND -->
  <section class="values">
    <div class="container center">
      <span class="eyebrow">Our Tagline</span>
      <h2 class="on-teal">
        <span class="script">Where tuft happens.</span>
      </h2>
      <p>
        Playful, memorable, and true to what the studio is all about — a place where ideas, yarn, laughter, and stories come together to create something you can live with and love.
      </p>
      <a href="/workshops#book" class="btn btn-primary">Book Your Experience</a>
    </div>
  </section>
</Layout>

<style>
  .about-grid, .founder-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  .founder-grid { grid-template-columns: 1fr 1.1fr; }
  @media (max-width: 800px) {
    .about-grid, .founder-grid { grid-template-columns: 1fr; }
  }
  .story-shell {
    max-width: 780px;
    margin: 0 auto;
    text-align: center;
  }
  .story-shell .eyebrow { display: inline-block; margin-bottom: 12px; }
  .story-shell .about-copy p { margin-left: auto; margin-right: auto; }

  .about-copy h2, .founder-copy h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
    margin-bottom: 16px;
  }
  .about-copy p, .founder-copy p {
    color: var(--ink-soft);
    margin: 0 0 16px;
  }
  .about-photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    display: block;
  }
  .about-photo.square {
    aspect-ratio: 1 / 1;
    object-position: center top;
  }

  /* MISSION BAND */
  .mission-band {
    background: var(--cream);
    padding: clamp(72px, 9vw, 120px) 0;
  }
  .mission-band .center { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .mission-band h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    line-height: 1.1;
    margin: 12px 0 20px;
    max-width: 22ch;
  }
  .mission-band p {
    max-width: 60ch;
    color: var(--ink-soft);
    margin: 0;
    font-size: 1.05rem;
  }

  /* WHAT WE OFFER */
  .section-head { max-width: 720px; margin-bottom: 40px; }
  .section-head h2 { font-size: clamp(1.8rem, 3.5vw, 2.6rem); line-height: 1.1; }
  .offer-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(20px, 2.5vw, 28px);
  }
  @media (max-width: 720px) { .offer-grid { grid-template-columns: 1fr; } }
  .offer-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(24px, 3vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .offer-card:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
  .offer-card h3 { color: var(--teal-ink); font-size: 1.3rem; margin: 0; }
  .offer-card p { margin: 0; color: var(--ink-soft); font-size: 0.98rem; }
  .offer-link { margin-top: auto; color: var(--terracotta); font-weight: 700; font-size: 0.95rem; }
  .offer-link:hover { color: var(--terracotta-deep); }

  /* FOUNDER */
  .founder { background: var(--paper); }
  .studio-list {
    list-style: none;
    padding: 0;
    margin: 0 0 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: var(--ink-soft);
  }
  .studio-list li { padding: 4px 0; font-size: 1rem; }
  .studio-list span { color: var(--teal-ink); font-weight: 700; }
  .founder-lede {
    background: var(--cream);
    padding: 16px 20px;
    border-left: 4px solid var(--terracotta);
    border-radius: var(--radius);
    color: var(--teal-ink) !important;
    font-size: 1.05rem;
    line-height: 1.4;
  }
  .founder-lede strong { display: block; margin-bottom: 4px; color: var(--teal); }

  /* TAGLINE CTA */
  .values {
    background: var(--teal);
    color: var(--cream);
    text-align: center;
    padding: clamp(72px, 10vw, 120px) 0;
  }
  .values .eyebrow { color: var(--sage); }
  .values .center { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .values .on-teal { color: var(--cream); font-size: clamp(2rem, 4vw, 3rem); margin: 12px 0 20px; }
  .values .script { font-size: clamp(3rem, 6vw, 5rem); color: var(--cream); line-height: 1; }
  .values p { max-width: 56ch; opacity: 0.9; margin: 0 0 28px; }
</style>
