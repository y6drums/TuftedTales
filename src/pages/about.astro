---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
---

<Layout title="About · Tufted Tales Studio" description="Tufted Tales Studio is a creative-experience rug tufting studio in Columbus, Georgia. Learn about our story, our name, and the people behind it.">
  <PageHero
    eyebrow="About Us"
    script="Every story"
    title="begins here."
    subtitle="Tufted Tales Studio is a hands-on rug tufting studio in Columbus, Georgia, serving the Chattahoochee Valley."
  />

  <!-- STORY -->
  <section>
    <div class="container about-grid">
      <div class="about-copy">
        <span class="eyebrow">Our Story</span>
        <h2>Where creativity meets craft.</h2>
        <p>
          We believe creativity is about more than making something beautiful — it's about creating memories,
          expressing yourself, and leaving with something that tells your story.
        </p>
        <p>
          What started as a love for tufting grew into something bigger: a space where people can gather,
          try something new, and turn their memories, favorite colors, inside jokes, and personal style
          into something they can actually take home. Whether you're planning a visit with friends,
          celebrating a special occasion, or experiencing tufting for the first time — the studio was
          designed to be creative, welcoming, and memorable.
        </p>
      </div>
      <div class="visual">
        <img src="/photos/studio-session-full.jpg" alt="A tufting session in progress at Tufted Tales Studio" class="about-photo" />
      </div>
    </div>
  </section>

  <!-- NAME -->
  <section class="name-section">
    <div class="container name-grid">
      <div>
        <span class="eyebrow">The Name</span>
        <h2>Every rug tells a tale.</h2>
      </div>
      <div class="name-halves">
        <div class="half">
          <p class="script-word">Tufted.</p>
          <p>Speaks to the craft itself — the texture, the yarn, and the process of creating something by hand.</p>
        </div>
        <div class="half">
          <p class="script-word">Tales.</p>
          <p>Reflects the meaning behind each piece. No two rugs are exactly alike, and no two stories are either.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FOUNDER -->
  <section class="founder">
    <div class="container founder-grid">
      <div class="visual">
        <img src="/photos/founder-portrait.jpg" alt="Taiylor Williams, founder of Tufted Tales Studio" class="about-photo square" />
      </div>
      <div class="founder-copy">
        <span class="eyebrow">Meet the Founder</span>
        <h2>Taiylor Williams.</h2>
        <p>
          Tufted Tales Studio is the vision of founder Taiylor Williams, born from a love of the craft and
          a belief that creativity has the power to bring people together. The studio is rooted in the
          spirit of <strong>Good Shepherd Creations</strong> — shaped by the idea that what you make with
          your hands should feel personal from start to finish.
        </p>
        <p>
          That connection is part of what gives Tufted Tales Studio its heart: creativity, confidence,
          community, and the belief that every guest leaves with more than just a rug — they leave with
          a story of their own.
        </p>
      </div>
    </div>
  </section>

  <!-- VALUES / TAGLINE BAND -->
  <section class="values">
    <div class="container center">
      <span class="eyebrow">Our Tagline</span>
      <h2 class="on-teal">
        <span class="script">Where tuft happens.</span>
      </h2>
      <p>
        Playful, memorable, and true to what the studio is all about — a place where ideas, yarn,
        laughter, and stories come together to create something you can live with and love.
      </p>
      <a href="/waitlist" class="btn btn-primary">Join the Waitlist</a>
    </div>
  </section>
</Layout>

<style>
  .about-grid, .founder-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  .founder-grid { grid-template-columns: 1fr 1.1fr; }
  @media (max-width: 800px) {
    .about-grid, .founder-grid { grid-template-columns: 1fr; }
  }

  .about-copy h2, .founder-copy h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
    margin-bottom: 16px;
  }
  .about-copy p, .founder-copy p {
    color: var(--ink-soft);
    margin: 0 0 16px;
  }
  .about-photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    display: block;
  }
  .about-photo.square {
    aspect-ratio: 1 / 1;
    object-position: center top;
  }

  .name-section {
    background: var(--cream);
  }
  .name-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 48px;
    align-items: flex-start;
  }
  @media (max-width: 800px) { .name-grid { grid-template-columns: 1fr; } }
  .name-grid h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
  }
  .name-halves {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  @media (max-width: 640px) { .name-halves { grid-template-columns: 1fr; } }
  .half { padding: 24px; background: #fff; border-radius: var(--radius-lg); }
  .script-word {
    font-family: var(--font-display);
    font-size: 3rem;
    color: var(--terracotta);
    margin: 0 0 8px;
    line-height: 1;
  }
  .half p:last-child { color: var(--ink-soft); margin: 0; }

  .founder { background: var(--paper); }

  .values {
    background: var(--teal);
    color: var(--cream);
    text-align: center;
    padding: clamp(72px, 10vw, 120px) 0;
  }
  .values .eyebrow { color: var(--sage); }
  .values .center { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .values .on-teal { color: var(--cream); font-size: clamp(2rem, 4vw, 3rem); margin: 12px 0 20px; }
  .values .script { font-size: clamp(3rem, 6vw, 5rem); color: var(--cream); line-height: 1; }
  .values p { max-width: 56ch; opacity: 0.9; margin: 0 0 28px; }
</style>
