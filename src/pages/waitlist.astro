---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Join the Waitlist · Tufted Tales Studio" description="Be first through the door. Join the Tufted Tales Studio waitlist for early access to bookings, launch events, and a first-timer discount.">
  <section class="hero">
    <div class="container hero-grid">
      <div class="copy">
        <span class="eyebrow">Opening September 2026</span>
        <h1>
          <span class="script">Be first</span>
          <span class="block">through the door.</span>
        </h1>
        <p class="lede">
          Join the waitlist to get:
        </p>
        <ul class="perks">
          <li><span>Early access</span> — book workshops before public opening</li>
          <li><span>A first-timer discount</span> — 15% off your first workshop</li>
          <li><span>Launch event invites</span> — grand opening, previews, and more</li>
          <li><span>No spam</span> — just the good stuff, promise</li>
        </ul>
      </div>

      <div class="form-shell">
        <form
          name="waitlist"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="wl-form"
          action="/waitlist?ok=1"
        >
          <input type="hidden" name="form-name" value="waitlist" />
          <p class="visually-hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>

          <div class="form-field">
            <label for="name">Your name *</label>
            <input id="name" name="name" type="text" required autocomplete="name" />
          </div>

          <div class="form-field">
            <label for="email">Email *</label>
            <input id="email" name="email" type="email" required autocomplete="email" />
          </div>

          <div class="form-field">
            <label for="phone">Phone (for SMS updates, optional)</label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" />
            <p class="form-hint">We'll text launch updates only. You can opt out any time.</p>
          </div>

          <fieldset class="checkbox-group">
            <legend>What are you interested in? <span class="opt">(optional)</span></legend>
            <label class="checkbox"><input type="checkbox" name="interest" value="signature-workshop" /> Signature Workshop ($75)</label>
            <label class="checkbox"><input type="checkbox" name="interest" value="custom-workshop" /> Custom Workshop ($85)</label>
            <label class="checkbox"><input type="checkbox" name="interest" value="private-event" /> Private Event / Party</label>
            <label class="checkbox"><input type="checkbox" name="interest" value="custom-rug" /> Custom Rug Commission</label>
          </fieldset>

          <div class="form-field">
            <label for="hear">How did you hear about us?</label>
            <select id="hear" name="hear">
              <option value="">Select one…</option>
              <option>Instagram</option>
              <option>TikTok</option>
              <option>Facebook</option>
              <option>YouTube</option>
              <option>Google</option>
              <option>A friend</option>
              <option>Drove by the studio</option>
              <option>Other</option>
            </select>
          </div>

          <button type="submit" class="btn btn-primary form-submit">Join the Waitlist</button>
          <p class="privacy">We'll never sell your info. Ever.</p>
        </form>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    background:
      radial-gradient(1000px 500px at 90% 10%, rgba(178, 178, 103, 0.35), transparent 60%),
      radial-gradient(700px 400px at 10% 90%, rgba(6, 73, 70, 0.10), transparent 55%),
      var(--paper);
    padding: clamp(48px, 8vw, 96px) 0;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  @media (max-width: 880px) { .hero-grid { grid-template-columns: 1fr; } }

  .copy h1 {
    display: flex;
    flex-direction: column;
    margin: 12px 0 24px;
  }
  .script {
    font-family: var(--font-display);
    font-size: clamp(3.6rem, 8vw, 5.6rem);
    color: var(--teal);
    line-height: 0.9;
  }
  .block {
    font-family: var(--font-block);
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    color: var(--terracotta);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    margin-left: 6px;
    margin-top: 4px;
  }
  .lede { font-size: 1.1rem; color: var(--ink-soft); margin: 0 0 18px; }

  .perks {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 1rem;
  }
  .perks li::before {
    content: "✱";
    color: var(--terracotta);
    margin-right: 10px;
    font-weight: 700;
  }
  .perks span {
    font-weight: 700;
    color: var(--teal-ink);
  }

  .form-shell { }
  .wl-form {
    background: #fff;
    padding: clamp(28px, 4vw, 44px);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--line);
  }
  .form-submit {
    margin-top: 12px;
    width: 100%;
  }
  .privacy {
    text-align: center;
    font-size: 0.82rem;
    color: var(--muted);
    margin: 12px 0 0;
  }
  .checkbox-group {
    border: 1.5px solid var(--line);
    border-radius: var(--radius);
    padding: 16px 18px;
    margin-bottom: 18px;
  }
  .checkbox-group legend {
    padding: 0 8px;
    font-weight: 600;
    color: var(--teal-ink);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
  }
  .checkbox-group .opt { font-weight: 400; color: var(--muted); }
  .checkbox {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
    font-weight: 500 !important;
    font-size: 0.95rem !important;
    color: var(--ink-soft) !important;
    margin-bottom: 0 !important;
    cursor: pointer;
  }
  .checkbox input { width: auto; margin: 0; accent-color: var(--terracotta); }
  .visually-hidden { position: absolute; left: -9999px; }
</style>

<!-- Success message shown when redirected here after form submit -->
<script>
  const params = new URLSearchParams(window.location.search);
  if (params.get("ok") === "1") {
    const form = document.querySelector<HTMLFormElement>(".wl-form");
    if (form) {
      form.innerHTML = `
        <div style="text-align:center; padding: 20px 0;">
          <div style="font-family: var(--font-display); font-size: 3rem; color: var(--teal); line-height: 1; margin-bottom: 12px;">You're on the list!</div>
          <p style="color: var(--ink-soft); margin: 0;">We'll be in touch as we get closer to opening. Thanks for being here.</p>
        </div>
      `;
    }
  }
</script>
