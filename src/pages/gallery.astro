---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";

const items = [
  { src: "/photos/IMG_0402.jpg", alt: "Workshop customer with 'NAKED' tufted piece and certificate of completion" },
  { src: "/photos/IMG_2714.jpg", alt: "Workshop customer with 'PARIS' pink-and-white tufted piece" },
  { src: "/photos/IMG_3303.jpg", alt: "Workshop customer with 'GOT 'EM' tufted piece" },
  { src: "/photos/IMG_3309.jpg", alt: "Workshop customer with finished tufted piece" },
  { src: "/photos/IMG_3790.jpg", alt: "Workshop customer with finished tufted piece" },
  { src: "/photos/IMG_3807.jpg", alt: "Workshop customer with finished tufted piece" },
  { src: "/photos/IMG_5957.jpg", alt: "Workshop customer with finished tufted piece" },
  { src: "/photos/tufting-cherry-frame.jpg", alt: "Cherry rug being tufted on the frame" },
  { src: "/photos/tufting-hello-kitty.jpg", alt: "Hello Kitty rug in progress on the tufting frame" },
  { src: "/photos/tufting-hands-closeup.jpg", alt: "Close-up of hands using the tufting gun" },
  { src: "/photos/rug-anime-face.jpg", alt: "Custom anime-style face rug" },
  { src: "/photos/rug-playstation.jpg", alt: "Custom PlayStation-inspired rug" },
  { src: "/photos/rug-flower.jpg", alt: "Custom flower rug" },
  { src: "/photos/tufting-sunset-rug.jpg", alt: "Custom sunset landscape rug" },
  { src: "/photos/owner-custom-rug.jpg", alt: "Custom rug commission" },
];
---

<Layout title="Gallery · Tufted Tales Studio" description="See rugs, Tale Bears, and private-party moments from Tufted Tales Studio in Columbus, GA.">
  <PageHero
    eyebrow="Gallery"
    script="Memories included."
    title="Made here."
    subtitle="Every visit to Tufted Tales Studio tells a story. Browse moments from our rug tufting workshops, Tale Bears experiences, private parties, and custom creations. Every piece is handmade, every visit is unique, and every guest leaves with a story worth sharing."
  />

  <section class="gallery">
    <div class="container">
      <div class="gallery-grid">
        {items.map((it) => (
          <figure class="gal-tile">
            <img src={it.src} alt={it.alt} loading="lazy" />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA BAND -->
  <section class="cta-band">
    <div class="container center">
      <span class="eyebrow">Ready to Create?</span>
      <h2>Ready to create your own story?</h2>
      <p>
        Whether you're planning a date night, birthday celebration, girls' night out, private event, or simply looking for a fun creative experience, we'd love to welcome you to Tufted Tales Studio.
      </p>
      <div class="cta-row">
        <a href="/workshops#book" class="btn btn-primary">Book Your Experience</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  @media (max-width: 800px) { .gallery-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .gallery-grid { grid-template-columns: 1fr; } }

  .gal-tile {
    margin: 0;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--cream);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .gal-tile:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }
  .gal-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cta-band {
    background: var(--teal);
    color: var(--cream);
    padding: clamp(72px, 10vw, 120px) 0;
  }
  .cta-band .eyebrow { color: var(--sage); }
  .cta-band .center { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .cta-band h2 { color: var(--cream); font-size: clamp(2rem, 4vw, 3rem); line-height: 1.05; margin: 12px 0 20px; }
  .cta-band p { max-width: 60ch; opacity: 0.9; margin: 0 0 28px; }
  .cta-row { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; }
  .btn-outline-cream { color: var(--cream); border-color: rgba(238, 214, 191, 0.5); background: transparent; }
  .btn-outline-cream:hover { background: var(--cream); color: var(--teal-ink); border-color: var(--cream); }
</style>
