---
import Layout from "../layouts/Layout.astro";
import Accent from "../components/Accent.astro";
---

<Layout
  title="Rug Tufting Studio in Columbus, GA | Tufted Tales Studio"
  description="Rug tufting and Tale Bears studio in Columbus, GA. Book a beginner-friendly workshop, host a private party, or commission a custom hand-tufted rug."
>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1 class="hero-logo">
          <img src="/brand/tts-sticker.svg" alt="Tufted Tales Studio — Where Tuft Happens" />
        </h1>
        <span class="eyebrow hero-tagline">Rug Tufting &amp; Tale Bears · Columbus, GA</span>
        <p class="lede">
          A hands-on rug tufting and Tale Bears studio in Columbus, GA. Pick a design,
          learn to tuft, and walk out with a rug you made yourself — no experience needed.
        </p>
        <div class="hero-ctas">
          <a href="/workshops#book" class="btn btn-primary">Book Your Experience · From $34.99</a>
          <a href="/private-events" class="btn btn-outline">Host a Private Party</a>
        </div>
        <ul class="hero-bullets">
          <li><span>All materials included</span> · no experience needed</li>
          <li><span>Instructor-led</span> · beginner friendly</li>
          <li><span>Take it home</span> · a piece that's actually yours</li>
        </ul>
      </div>

      <div class="hero-video">
        <video
          class="hero-video-el"
          src="/video/hero.mp4"
          poster="/video/hero-poster.jpg"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-label="Rug tufting at Tufted Tales Studio"
        ></video>
        <Accent color="olive" size="100px" spin speed="22s" class="hero-sticker" />
      </div>
    </div>
  </section>

  <!-- 10-SECOND ANSWER STRIP -->
  <section class="answer-strip">
    <div class="container answer-grid">
      <div class="answer">
        <div class="num">01</div>
        <h3>What we are</h3>
        <p>A rug tufting and Tale Bears studio for first-timers, friends, date nights, and celebrations in Columbus, GA.</p>
      </div>
      <div class="answer">
        <div class="num">02</div>
        <h3>What you can do</h3>
        <p>Tuft a rug, paint a Tale Bear, host a private party, or commission a custom piece.</p>
      </div>
      <div class="answer">
        <div class="num">03</div>
        <h3>How much</h3>
        <p>Tale Bears from $34.99. Rug workshops from $85. Private parties from $1,080.</p>
      </div>
      <div class="answer">
        <div class="num">04</div>
        <h3>How to book</h3>
        <p>Book online — sessions start with our September 2026 opening.</p>
      </div>
    </div>
  </section>

  <!-- WORKSHOPS PREVIEW -->
  <section class="workshops-preview">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Workshops</span>
        <h2>Three ways to <em>create</em>.</h2>
        <p class="section-lede">
          Beginner-friendly tufting, the full rug-making process, or our signature paint-poured Tale Bears —
          pick what fits you.
        </p>
      </div>

      <div class="workshop-grid">
        <article class="workshop-card teal">
          <span class="chip">Signature</span>
          <h3>Signature Tuft Experience</h3>
          <p class="price">$85 <span>per person</span></p>
          <ul class="feat">
            <li>3–3.5 hour instructor-led tufting</li>
            <li>Choose from our curated design library</li>
            <li>All materials + 20+ yarn colors included</li>
            <li>Professionally finished — ready in 24–48 hrs</li>
          </ul>
          <a href="/workshops#book" class="btn btn-ghost">See Available Dates</a>
        </article>

        <article class="workshop-card cream">
          <span class="chip terra">Full Experience</span>
          <h3>Complete Rug Maker Experience</h3>
          <p class="price">$99 <span>per person</span></p>
          <ul class="feat">
            <li>4–4.5 hours — tuft + learn finishing</li>
            <li>Shave, trim, glue, and back your own rug</li>
            <li>All materials + 20+ yarn colors included</li>
            <li>Take your finished rug home same day</li>
          </ul>
          <a href="/workshops#book" class="btn btn-primary">See Available Dates</a>
        </article>

        <article class="workshop-card terracotta">
          <span class="chip cream-chip">Paint Pour</span>
          <h3>Tale Bears Experience</h3>
          <p class="price">From $34.99</p>
          <ul class="feat">
            <li>7" bear $34.99 · 9" bear $54.99</li>
            <li>Signature paint-pour technique</li>
            <li>Up to 3 paint colors + refills included</li>
            <li>Professionally sealed — ready in 24–48 hrs</li>
          </ul>
          <a href="/workshops#book" class="btn btn-ghost">See Available Dates</a>
        </article>
      </div>
    </div>
  </section>

  <!-- ABOUT SHORT -->
  <section class="about-short">
    <div class="container about-grid">
      <div class="about-visual">
        <img src="/photos/founder-portrait.jpg" alt="Taiylor Williams, founder of Tufted Tales Studio" class="founder-photo" />
        <img src="/brand/tts-badge.svg" alt="" class="badge-float" aria-hidden="true" />
      </div>
      <div class="about-copy">
        <span class="eyebrow">Our Story</span>
        <h2>Every rug tells a tale.</h2>
        <p>
          Tufted Tales Studio is a rug tufting and Tale Bears studio in Columbus, Georgia,
          serving the Chattahoochee Valley. Pick a design, pick up the tools, and leave
          with something you made yourself — a tufted rug or a paint-poured vinyl bear.
          No two come out the same.
        </p>
        <p>
          "Tufted" is the craft — the yarn, the texture, the making. "Tales" is what you bring to it.
        </p>
        <a href="/about" class="btn btn-outline">Read Our Story</a>
      </div>
    </div>
  </section>

  <!-- GALLERY PREVIEW -->
  <section class="gallery-preview">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Gallery</span>
        <h2>Made here, loved forever.</h2>
      </div>
      <div class="gallery-strip">
        {[
          { src: "/photos/tufting-cherry-frame.jpg", alt: "Cherry rug in progress on the tufting frame" },
          { src: "/photos/rug-anime-face.jpg", alt: "Custom anime-style face rug" },
          { src: "/photos/IMG_2714.jpg", alt: "Workshop customer with finished 'PARIS' tufted piece" },
          { src: "/photos/rug-playstation.jpg", alt: "Custom PlayStation-inspired rug" },
          { src: "/photos/tufting-hello-kitty.jpg", alt: "Hello Kitty rug in progress" },
          { src: "/photos/IMG_0402.jpg", alt: "Workshop customer with finished 'NAKED' tufted piece" },
        ].map((p) => (
          <a href="/gallery" class="gal-item">
            <img src={p.src} alt={p.alt} loading="lazy" />
          </a>
        ))}
      </div>
      <div class="center-cta">
        <a href="/gallery" class="btn btn-outline">See the Full Gallery</a>
      </div>
    </div>
  </section>

  <!-- BOOK YOUR FIRST SESSION -->
  <section class="waitlist-band">
    <div class="container waitlist-inner">
      <Accent color="olive" size="140px" spin speed="30s" class="wl-accent left" />
      <div class="waitlist-copy">
        <span class="eyebrow" style="color: var(--sage);">Opening September 2026</span>
        <h2 class="on-teal">
          <span class="script">Book your first session.</span>
        </h2>
        <p>
          Sessions start with our September 2026 opening — reserve your spot and get a first-timer discount.
        </p>
        <a href="/workshops#book" class="btn btn-primary">Book Your Experience</a>
      </div>
      <Accent color="olive" size="140px" spin reverse speed="30s" class="wl-accent right" />
    </div>
  </section>
</Layout>

<style>
  /* ---------- HERO ---------- */
  .hero {
    padding-top: clamp(48px, 6vw, 80px);
    padding-bottom: clamp(64px, 8vw, 100px);
    background:
      radial-gradient(1200px 500px at 90% -10%, rgba(178, 178, 103, 0.35), transparent 60%),
      radial-gradient(900px 400px at -10% 10%, rgba(6, 73, 70, 0.10), transparent 55%),
      var(--paper);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  .hero-tagline {
    display: inline-block;
    margin-bottom: 24px;
  }
  .hero-logo {
    margin: 0 0 24px;
    line-height: 0;
  }
  .hero-logo img {
    width: 100%;
    max-width: 560px;
    height: auto;
    display: block;
  }
  .lede {
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    color: var(--ink-soft);
    max-width: 46ch;
    margin: 0 0 32px;
  }
  .hero-ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 36px;
  }
  .hero-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }
  .hero-bullets li::before {
    content: "✱";
    color: var(--terracotta);
    margin-right: 10px;
    font-weight: 700;
  }
  .hero-bullets span {
    font-weight: 700;
    color: var(--teal-ink);
  }

  .hero-video {
    position: relative;
  }
  .hero-video-el {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-lg);
    background: var(--teal-ink);
    box-shadow: var(--shadow-lg);
    display: block;
  }
  :global(.hero-sticker) {
    position: absolute !important;
    top: -30px;
    right: -30px;
    z-index: 2;
  }

  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-video { max-width: 480px; margin: 0 auto; }
    :global(.hero-sticker) { width: 70px !important; height: 70px !important; top: -20px; right: -10px; }
  }

  /* ---------- ANSWER STRIP ---------- */
  .answer-strip {
    background: var(--cream);
    padding: clamp(48px, 6vw, 72px) 0;
  }
  .answer-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }
  .answer {
    text-align: left;
  }
  .num {
    font-family: var(--font-block);
    color: var(--terracotta);
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    margin-bottom: 10px;
  }
  .answer h3 {
    font-size: 1.2rem;
    margin-bottom: 8px;
    color: var(--teal-ink);
  }
  .answer p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  @media (max-width: 800px) {
    .answer-grid { grid-template-columns: repeat(2, 1fr); gap: 28px; }
  }
  @media (max-width: 460px) {
    .answer-grid { grid-template-columns: 1fr; }
  }

  /* ---------- SECTION HEADS ---------- */
  .section-head {
    max-width: 620px;
    margin-bottom: 48px;
  }
  .section-head.center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }
  .accent-center {
    display: flex;
    justify-content: center;
    margin-bottom: 12px;
  }
  .section-head h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
    margin-bottom: 14px;
  }
  .section-head h2 em {
    font-family: var(--font-display);
    font-style: normal;
    color: var(--terracotta);
    font-weight: 400;
    font-size: 1.5em;
    line-height: 0.8;
    vertical-align: -0.05em;
  }
  .section-lede {
    font-size: 1.05rem;
    color: var(--ink-soft);
    margin: 0;
  }

  /* ---------- WORKSHOPS ---------- */
  .workshop-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .workshop-card {
    border-radius: var(--radius-lg);
    padding: clamp(24px, 2.4vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .workshop-card.teal {
    background: var(--teal);
    color: var(--cream);
  }
  .workshop-card.teal h3 { color: var(--cream); }
  .workshop-card.teal .chip {
    background: rgba(238, 214, 191, 0.15);
    color: var(--cream);
  }
  .workshop-card.cream {
    background: var(--cream);
    color: var(--teal-ink);
  }
  .workshop-card .chip.terra {
    background: var(--terracotta);
    color: var(--cream);
  }
  .workshop-card.terracotta {
    background: var(--terracotta);
    color: var(--cream);
  }
  .workshop-card.terracotta h3 { color: var(--cream); }
  .workshop-card.terracotta .chip.cream-chip {
    background: rgba(238, 214, 191, 0.2);
    color: var(--cream);
  }
  .workshop-card h3 {
    font-size: 1.4rem;
    margin: 4px 0 0;
    line-height: 1.15;
  }
  .price {
    font-family: var(--font-block);
    font-size: 1.7rem;
    color: var(--terracotta);
    margin: 0;
    letter-spacing: 0;
  }
  .workshop-card.teal .price { color: var(--sage); }
  .workshop-card.terracotta .price { color: var(--cream); }
  .price span {
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    color: currentColor;
    opacity: 0.7;
    margin-left: 8px;
    font-family: var(--font-body);
    font-weight: 500;
  }
  .feat {
    list-style: none;
    padding: 0;
    margin: 8px 0 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.92rem;
  }
  .feat li::before {
    content: "→";
    margin-right: 10px;
    color: var(--terracotta);
    font-weight: 700;
  }
  .workshop-card.teal .feat li::before { color: var(--sage); }
  .workshop-card.terracotta .feat li::before { color: var(--cream); }
  .workshop-card .btn { align-self: flex-start; }

  @media (max-width: 960px) {
    .workshop-grid { grid-template-columns: 1fr; }
  }

  /* ---------- ABOUT SHORT ---------- */
  .about-short {
    background:
      radial-gradient(700px 400px at 90% 30%, rgba(178, 178, 103, 0.2), transparent 60%),
      var(--paper);
  }
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  .about-visual { position: relative; }
  .founder-photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 20%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    display: block;
  }
  .badge-float {
    position: absolute;
    bottom: -30px;
    left: -30px;
    width: 130px;
    height: 130px;
    background: var(--cream);
    border-radius: 50%;
    padding: 12px;
    box-shadow: var(--shadow);
  }
  .about-copy h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
    margin-bottom: 16px;
  }
  .about-copy p {
    margin: 0 0 16px;
    color: var(--ink-soft);
    font-size: 1rem;
  }
  .about-copy em {
    font-family: var(--font-display);
    color: var(--terracotta);
    font-style: normal;
    font-size: 1.15em;
  }

  @media (max-width: 800px) {
    .about-grid { grid-template-columns: 1fr; }
    .badge-float { width: 90px; height: 90px; bottom: -20px; left: 12px; }
  }

  /* ---------- GALLERY STRIP ---------- */
  .gallery-strip {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 12px;
    margin-bottom: 40px;
  }
  .gal-item {
    aspect-ratio: 1 / 1;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--cream);
    display: block;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .gal-item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }
  .gal-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .center-cta { text-align: center; }

  @media (max-width: 720px) {
    .gallery-strip { grid-template-columns: repeat(3, 1fr); }
  }

  /* ---------- WAITLIST BAND ---------- */
  .waitlist-band {
    background:
      radial-gradient(500px 200px at 50% 100%, rgba(176, 71, 37, 0.25), transparent 70%),
      var(--teal);
    color: var(--cream);
    text-align: center;
    padding: clamp(72px, 10vw, 120px) 0;
    position: relative;
    overflow: hidden;
  }
  .waitlist-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 40px;
  }
  .waitlist-copy {
    max-width: 620px;
  }
  .waitlist-copy h2.on-teal {
    color: var(--cream);
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    line-height: 1;
    margin: 8px 0 16px;
  }
  .waitlist-copy .script {
    font-size: clamp(3rem, 6vw, 4.4rem);
    color: var(--cream);
    word-spacing: -0.12em;
    letter-spacing: -0.01em;
  }
  .waitlist-copy p {
    font-size: 1.1rem;
    opacity: 0.88;
    margin: 0 auto 28px;
    max-width: 46ch;
  }
  :global(.wl-accent) {
    opacity: 0.85;
    flex-shrink: 0;
  }
  @media (max-width: 720px) {
    :global(.wl-accent) { display: none; }
  }
</style>
